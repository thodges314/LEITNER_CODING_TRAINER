{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "preserve",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["*.ref.ts", "sandbox-env.d.ts"]
}

