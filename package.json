{
  "name": "leitner-coding-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:cards": "node scripts/build-cards.mjs",
    "check:cards": "node scripts/build-cards.mjs --check",
    "e2e": "vite build && playwright test",
    "e2e:ui": "vite build && playwright test --ui",
    "mutation": "vitest run --config vitest.mutation.config.ts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "d3": "^7.9.0",
    "lucide-react": "^1.55.0",
    "prettier": "^3.9.10",
    "rainbowbrackets": "^2.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
